# Optional override for local application data directory.
# CYBERSEC_HOME=/absolute/path/to/.cybersec

# Local HTTP API client settings. Keep the real token in your shell environment,
# never commit it to source control.
CYBERSEC_API_URL=http://127.0.0.1:8765
# CYBERSEC_API_TOKEN=replace-with-a-random-secret-at-least-24-characters
CYBERSEC_API_TIMEOUT=3.0
CYBERSEC_API_RETRIES=2
CYBERSEC_API_RETRY_BACKOFF=0.15
